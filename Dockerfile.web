# syntax=docker/dockerfile:1.7
FROM rust:1.88.0-bookworm AS rust-tools

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo install wasm-pack --version 0.15.0 --locked

FROM node:24.4.1-bookworm-slim AS build

ENV PATH=/usr/local/cargo/bin:${PATH}
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
WORKDIR /workspace

COPY --from=rust-tools /usr/local/rustup /usr/local/rustup
COPY --from=rust-tools /usr/local/cargo /usr/local/cargo
RUN rustup target add wasm32-unknown-unknown

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY frontend/sprout-web/package.json frontend/sprout-web/package-lock.json ./frontend/sprout-web/
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci --prefix frontend/sprout-web --no-audit --no-fund
COPY frontend/sprout-web ./frontend/sprout-web

ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
RUN npm --prefix frontend/sprout-web run wasm:build \
    && npm --prefix frontend/sprout-web run build

FROM nginxinc/nginx-unprivileged:1.29.0-alpine AS runtime

COPY deploy/nginx-sprout.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx-security-headers.conf /etc/nginx/sprout-security-headers.conf
COPY --from=build --chown=101:101 /workspace/frontend/sprout-web/dist /usr/share/nginx/html

EXPOSE 8080
