# Copy to a protected environment file and replace every placeholder.
# Do not commit populated environment files.
SPROUT_BIND_ADDR=127.0.0.1:8080
SPROUT_BASE_URL=http://localhost:8080
# Development is the only runnable mode until the independent crypto audit
# gate is satisfied. Never carry this opt-in into a production environment.
SPROUT_ENVIRONMENT=development
SPROUT_ENABLE_EXPERIMENTAL_CRYPTO_FOR_DEVELOPMENT=true
SPROUT_HEALTH_PATH=/health/ready
DATABASE_URL=postgresql://sprout:replace-with-a-local-or-injected-password@127.0.0.1:5432/sprout
SPROUT_MIGRATIONS_DIR=/opt/sprout/migrations
SPROUT_BLOB_DIR=/var/lib/sprout/blobs
SPROUT_ARCHIVE_DIR=/var/lib/sprout/archives
SPROUT_EMAIL_OUTBOX_KEY=replace-with-base64-encoded-32-byte-key
SPROUT_ARCHIVE_SIGNING_KEY=replace-with-base64-encoded-ed25519-seed
SPROUT_ARCHIVE_SIGNING_KEY_ID=11111111-1111-4111-8111-111111111111
SPROUT_METRICS_TOKEN=replace-with-a-long-random-bearer-token
SPROUT_AUTH_RATE_LIMIT_PER_MINUTE=30
SPROUT_RECOVERY_RATE_LIMIT_PER_MINUTE=10
SPROUT_SESSION_RATE_LIMIT_PER_MINUTE=600
RUST_LOG=sprout_server=info,tower_http=info
